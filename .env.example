# =================================================================
# VoxAI Studio - Environment Configuration
# =================================================================
# Copy this file to `.env` and insert your actual ElevenLabs API key.
#
# IMPORTANT:
# - NEVER commit your `.env` file to source control.
# - The backend reads this securely. It is NEVER exposed to the frontend.
# =================================================================

# Your ElevenLabs API Key (Get yours from https://elevenlabs.io -> Profile -> API Keys)
ELEVENLABS_API_KEY=your_elevenlabs_api_key_here

# Port for VoxAI Studio server (default: 3000)
PORT=3000

# Optional: Default TTS Model
# Recommended options:
# - eleven_multilingual_v2 (Best overall quality & multi-language support)
# - eleven_turbo_v2_5 (Fastest response time, great for English)
# - eleven_monolingual_v1 (Standard English)
DEFAULT_MODEL_ID=eleven_multilingual_v2
